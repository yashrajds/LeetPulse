# Copy to .env and fill in. NEVER commit .env.
PORT=4000

# Database: sqlite (local, default) | firestore (prod)
DB_PROVIDER=sqlite
DATABASE_PATH=./data/leetpulse.db

# Firebase (production Firestore — replaces sqlite when DB_PROVIDER=firestore).
# Option A: service-account JSON path (recommended for servers)
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: individual fields (FIREBASE_PROJECT_ID also auto-selects firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI provider: openai | anthropic | gemini | groq | ollama | mock
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Dev bypass (no LeetCode / AI / browser needed)
MOCK_MODE=true

# Scheduler
SCHEDULE_ENABLED=true
SCHEDULE_CRON=30 6 * * *
SCHEDULE_TIMEZONE=Asia/Kolkata
DISABLE_SCHEDULER=false

# Automation defaults
DEFAULT_LANGUAGE=python
AUTO_SUBMIT=false
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_PROFILE_DIR=./data/pw-profile

# Optional shared secret: frontend sends `Authorization: Bearer <token>`
API_TOKEN=

# Frontend
VITE_API_URL=http://localhost:4000
